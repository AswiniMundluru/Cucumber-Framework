{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck" : true,
    "strict": true,
    "noEmit" :true,
    "ignoreDeprecations" :"6.0",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "features/**/*.ts"]
}